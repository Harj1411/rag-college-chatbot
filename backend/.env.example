# Gemini API Key (Required for RAG embeddings and LLM responses)
# Get yours from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection String (Optional: falls back to in-memory store if not reachable)
MONGO_URI=mongodb://localhost:27017
DB_NAME=campusmind

# JWT Secret Key and Algorithm
JWT_SECRET=campusmind_super_secure_jwt_secret_key_change_me_in_prod_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# RAG & Storage Configuration
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads
MIN_SIMILARITY_SCORE=0.35
TOP_K_CHUNKS=4

# Server & CORS
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
